# IP del PC en la red local (la que usará la Pi 5 para conectarse a Kafka)
HOST_IP=192.168.100.8

# Puerto del listener EXTERNAL de Kafka (Pi 5 → PC)
KAFKA_EXTERNAL_PORT=29092

# Puerto del dashboard en el host
DASHBOARD_PORT=5000

# ID del clúster KRaft (obligatorio en cp-kafka). Generar uno propio con:
#   docker run --rm confluentinc/cp-kafka:7.7.8 kafka-storage random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk